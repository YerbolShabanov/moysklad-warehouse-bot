# Токен Telegram-бота от @BotFather
TELEGRAM_TOKEN=123456:AA...

# Токен доступа МойСклад (Настройки -> Профиль -> Токен доступа к API)
MOYSKLAD_TOKEN=

# Название склада с адресным хранением
MOYSKLAD_STORE_NAME=Склад адрес. хранение

# Белый список Telegram user_id через запятую. Пусто = доступ всем
ALLOWED_USER_IDS=

# Необязательное: базовый URL API
MOYSKLAD_BASE_URL=https://api.moysklad.ru/api/remap/1.2

# Сокращать имена ячеек: «Ряд 10 место 9 этаж 2» -> «Р10-М9-Э2»
COMPACT_SLOT_NAMES=true
# Предельная ширина таблицы в символах: Telegram переносит длинные строки,
# а не прокручивает. Колонка с названием занимает остаток, режется середина.
TABLE_WIDTH=58

# Формат карточки заказа: xlsx (файл для печати), text или image
ORDER_FORMAT=xlsx

# Часовые пояса. Аккаунт МойСклад отдаёт даты в своём поясе и не
# сообщает его через API; склад работает в другом. Даты показываем
# по DISPLAY_TZ, а фильтры к API переводим обратно в MOYSKLAD_TZ.
MOYSKLAD_TZ=Europe/Moscow
DISPLAY_TZ=Asia/Almaty

# --- Оповещения о новых заказах в чат склада ---
# id закрытого чата (у групп он отрицательный). Узнать: добавьте бота в чат и
# отправьте там /chatid. Пусто или 0 = оповещения выключены.
NOTIFY_CHAT_ID=

# Как часто опрашивать МойСклад, секунды (минимум 15)
POLL_INTERVAL=20

# Постить только заказы в этих статусах, через запятую. Пусто = все новые.
# Например: Новый,Подтвержден
NOTIFY_STATES=

# Файл с отметкой «до какого заказа уже отправляли»
STATE_FILE=state.json

# С какого момента рассылать: today (начало текущего дня, по умолчанию),
# now (с момента запуска) или явная дата «2026-09-10 00:00:00»
NOTIFY_SINCE=today

# --- Маршрутизация заказов ---
# Kaspi без галочки «Экспресс доставка» -> копится в сводный сборочный лист.
# Kaspi с галочкой -> уходит сразу и отдельно, с пометкой ЭКСПРЕСС.
# Остальные каналы (ОПТ) -> отдельным сообщением, как раньше.
KASPI_CHANNEL=Kaspi магазин
EXPRESS_ATTRIBUTE=Экспресс доставка

# Сводный лист: сколько заказов максимум и сколько ждать наполнения.
# Поток ~50 заказов в сутки, поэтому 10 штук набираются за 2-3 часа —
# без таймера заказ мог бы пролежать до следующего дня.
BATCH_SIZE=10
BATCH_MAX_WAIT_MINUTES=60
BATCH_INTERVAL=60
BATCH_STATE_FILE=batch_state.json

# ОПТ: заказ заводят пустым и десятки минут наполняют позициями вручную.
# По «Новый» он ушёл бы в чат без единой строки, поэтому ждём статус,
# подтверждающий готовность к отгрузке. Несколько — через запятую.
OPT_CHANNEL=ОПТ
OPT_STATES=Моя Доставка
